[Unit]
Description=MediPOS Pro app server (Next.js standalone, :3000)
After=network.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
ExecStart=__RUNNER__ __ROOT__/.next/standalone/server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=DATABASE_URL=file:__DB__
Environment=SYNC_NODE_ID=HQ
Environment=SYNC_NODE_NAME=Headquarters
# Set the shared pairing secret here (same value on every branch device):
# Environment=SYNC_KEY=change-me
Restart=always
RestartSec=5
# SIGTERM then wait — never kill SQLite mid-commit
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
