generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String
  name             String
  email            String?
  phone            String?
  role             String    @default("cashier") // denormalized role slug (admin | pharmacist | cashier | custom)
  roleRef          Role?     @relation(fields: [roleId], references: [id])
  roleId           String?
  status           String    @default("active") // active | suspended
  branchRef        Branch?   @relation(fields: [branchId], references: [id])
  branchId         String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // base32 TOTP secret (stored while setup is in progress or enabled)
  recoveryCodes    String? // JSON array of hashed recovery codes
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Branch {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique // MAIN, OSU …
  address          String?
  city             String?
  phone            String?
  isActive         Boolean           @default(true)
  isDefault        Boolean           @default(false) // the seeded primary branch
  users            User[]
  medicines        Medicine[]
  branchPrices     BranchPrice[]
  sales            Sale[]
  purchases        Purchase[]
  shifts           Shift[]
  stockTakes       StockTake[]
  discountRequests DiscountRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BranchPrice {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  sellingPrice  Float // branch-level override for the medicine's selling price
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchId, medicineId])
  @@index([medicineId])
}

model Role {
  id          String       @id @default(cuid())
  slug        String       @unique // admin | pharmacist | cashier | inventory-clerk …
  name        String
  description String?
  isSystem    Boolean      @default(false) // system roles cannot be deleted
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // "medicines:create"
  module String // medicines
  action String // create
  roles  Role[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // role.created | role.updated | role.deleted | user.created | user.updated | user.deleted
  actorId    String?
  actorName  String
  actorRole  String? // actor's role name at the time
  targetType String // role | user
  targetId   String?
  targetName String?
  summary    String // human-readable one-liner
  changes    String? // JSON snapshot (permission diffs, role/status changes)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  medicines   Medicine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  medicines     Medicine[]
  purchases     Purchase[]
  stockReturns  StockReturn[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Medicine {
  id                   String         @id @default(cuid())
  name                 String
  genericName          String?
  brand                String?
  branchRef            Branch?        @relation(fields: [branchId], references: [id])
  branchId             String?
  sku                  String         @unique
  barcode              String?
  categoryId           String
  category             Category       @relation(fields: [categoryId], references: [id])
  supplierId           String?
  supplier             Supplier?      @relation(fields: [supplierId], references: [id])
  unit                 String         @default("Box")
  batchNumber          String?
  expiryDate           DateTime?
  stockQty             Int            @default(0)
  reorderLevel         Int            @default(20)
  costPrice            Float          @default(0)
  sellingPrice         Float          @default(0)
  prescriptionRequired Boolean        @default(false)
  insuranceCovered   Boolean        @default(false) // item is on the insurer's covered formulary
  innerUnit          String?        // sellable sub-unit, e.g. Tablet inside a Box
  innerQty           Int            @default(1)   // how many inner units per stock unit
  looseUnits         Int            @default(0)   // opened-pack loose inner units on hand
  quarantineQty      Int            @default(0)   // units held aside (expired/damaged, not sellable)
  location             String?
  status               String         @default("active")
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  logs                 InventoryLog[]
  returnItems          StockReturnItem[]
  branchPrices         BranchPrice[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  note        String?
  creditLimit Float    @default(0) // 0 = credit sales not allowed
  points      Int      @default(0) // loyalty points balance
  insurerId   String?
  insurer     Insurer? @relation(fields: [insurerId], references: [id])
  insuranceNo String? // NHIS / private insurance membership number
  allergies   String? // comma-separated allergy flags matched at POS
  sales       Sale[]
  ledger      CustomerLedger[]
  loyaltyLogs LoyaltyLog[]
  claims      InsuranceClaim[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Insurer {
  id              String   @id @default(cuid())
  name            String   @unique
  shortCode       String?
  phone           String?
  coveragePercent Float    @default(80) // % of a covered item's price the insurer pays
  active          Boolean  @default(true)
  note            String?
  customers       Customer[]
  claims          InsuranceClaim[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomerLedger {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId      String?
  saleId        String? // set when the entry originates from a sale
  saleInvoice   String?
  type          String // charge | payment | adjustment
  amount        Float // positive; charge adds to what the customer owes, payment reduces it
  method        String? // payment method (cash | momo | card) for payments
  reference     String? // momo txn id / receipt reference
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([customerId, createdAt])
}

model LoyaltyLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String?
  saleId     String?
  type       String // earn | redeem | adjust
  points     Int // signed delta applied to the customer's balance
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model InsuranceClaim {
  id          String    @id @default(cuid())
  claimNo     String    @unique // CLM-2026-0001
  saleId      String
  saleInvoice String?
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  insurerId   String
  insurer     Insurer   @relation(fields: [insurerId], references: [id])
  branchId    String?
  claimAmount Float     @default(0)
  status      String    @default("pending") // pending | submitted | paid | rejected
  submittedAt DateTime?
  paidAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Sale {
  id                String     @id @default(cuid())
  invoiceNo         String     @unique
  customerId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id])
  shiftId           String?
  shift             Shift?     @relation(fields: [shiftId], references: [id])
  branchRef         Branch?    @relation(fields: [branchId], references: [id])
  branchId          String?
  approvedById      String? // manager who authorized a large-discount sale
  approvedByName    String?
  discountRequestId String?
  subtotal          Float      @default(0)
  discount          Float      @default(0)
  tax               Float      @default(0)
  total             Float      @default(0)
  paidAmount        Float      @default(0)
  changeAmount      Float      @default(0)
  paymentMethod     String     @default("cash")
  paymentProvider   String? // momo provider: mtn | telecel | airteltigo
  paymentReference  String? // momo / insurance txn reference
  paymentStatus     String     @default("paid")
  pointsEarned      Int        @default(0) // loyalty points awarded for this sale
  pointsRedeemed    Int        @default(0) // loyalty points spent on this sale
  pointsValue       Float      @default(0) // currency value of redeemed points
  insuranceAmount   Float      @default(0) // portion billed to the insurer
  saleStatus        String     @default("completed")
  cashierName       String     @default("Admin User")
  note              String?
  clientRef         String?    @unique // offline idempotency key
  items             SaleItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model SaleItem {
  id         String    @id @default(cuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId String?
  medicine   Medicine? @relation(fields: [medicineId], references: [id])
  name       String
  sku        String?
  qty        Int
  unitPrice  Float
  discount   Float     @default(0)
  total      Float
  saleUnit   String    @default("pack") // pack | inner (loose-unit selling)
}

model Purchase {
  id           String         @id @default(cuid())
  referenceNo  String         @unique
  branchRef    Branch?        @relation(fields: [branchId], references: [id])
  branchId     String?
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime       @default(now())
  subtotal     Float          @default(0)
  tax          Float          @default(0)
  totalAmount  Float          @default(0)
  paidAmount   Float          @default(0)
  status       String         @default("pending")
  note         String?
  items        PurchaseItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId  String?
  medicine    Medicine? @relation(fields: [medicineId], references: [id])
  name        String
  qty         Int
  unitCost    Float
  batchNumber String?
  expiryDate  DateTime?
  total       Float
}

model Prescription {
  id          String   @id @default(cuid())
  code        String   @unique
  patientName String
  doctorName  String?
  phone       String?
  itemsText   String?
  notes       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryLog {
  id         String    @id @default(cuid())
  medicineId String?
  medicine   Medicine? @relation(fields: [medicineId], references: [id])
  type       String
  quantity   Int
  reason     String?
  reference  String?
  clientRef  String?   @unique // offline idempotency key
  createdAt  DateTime  @default(now())
}

model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// --- multi-node sync (offline-first replication) -----------------------------

model SyncOp {
  id        String   @id @default(cuid())
  nodeId    String // originating node (HQ or branch id)
  seq       Int // per-node monotonically increasing sequence
  op        String // sale.created | medicine.updated | inventory.adjusted | ledger.entry | ...
  targetKey String? // human key (invoice no, sku, ...) for logs
  payload   String // JSON snapshot of the operation
  appliedAt DateTime? // set once this op has been replicated out
  createdAt DateTime @default(now())

  @@index([nodeId, seq])
}

model SyncNode {
  id          String    @id // branch node id
  name        String
  lastSeenAt  DateTime?
  lastPushSeq Int       @default(0)
  opsApplied  Int       @default(0)
  createdAt   DateTime  @default(now())
}

model SyncState {
  id            String    @id // HQ_NODE_ID - cursor row per branch<->HQ pair
  lastPulledSeq Int       @default(0)
  lastPushedSeq Int       @default(0)
  lastSyncAt    DateTime?
  lastError     String?
}

model DiscoveredNode {
  id        String   @id @default(cuid())
  nodeId    String   @unique
  name      String
  role      String   @default("branch") // hq | branch
  source    String   @default("lan") // lan | internet | live | manual
  lanIp     String?
  httpUrl   String?
  tunnelUrl String?
  version   String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
}

model NodeSetting {
  key   String @id
  value String
}

model StockReturn {
  id            String            @id @default(cuid())
  returnNo      String            @unique // RET-2026-0001
  type          String            @default("writeoff") // writeoff | supplier_return
  reason        String            @default("expired") // expired | damaged | recalled | other
  status        String            @default("completed") // completed | cancelled
  supplierId    String?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  branchId      String?
  totalValue    Float             @default(0) // cost value of the removed stock
  note          String?
  createdById   String?
  createdByName String?
  items         StockReturnItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([createdAt])
}

model StockReturnItem {
  id          String      @id @default(cuid())
  returnId    String
  return      StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  medicineId  String?
  medicine    Medicine?   @relation(fields: [medicineId], references: [id])
  name        String
  sku         String?
  batchNumber String?
  expiryDate  DateTime?
  qty         Int
  unitCost    Float       @default(0)
  value       Float       @default(0)
  action      String      @default("writeoff") // writeoff | return_supplier | quarantine
  fromQuarantine Boolean  @default(false) // qty came out of Medicine.quarantineQty
}

model Shift {
  id           String         @id @default(cuid())
  shiftNo      String         @unique
  branchRef    Branch?        @relation(fields: [branchId], references: [id])
  branchId     String?
  userId       String
  userName     String
  userRole     String         @default("cashier")
  openingCash  Float          @default(0)
  closingCash  Float?
  expectedCash Float?
  variance     Float?
  status       String         @default("open") // open | closed
  note         String? // opening note
  closeNote    String?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  sales        Sale[]
  movements    CashMovement[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model CashMovement {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      String // addition | payout | drop
  amount    Float
  reason    String?
  userName  String
  createdAt DateTime @default(now())
}

model StockTake {
  id              String          @id @default(cuid())
  stockTakeNo     String          @unique // ST-2026-0001
  branchRef       Branch?         @relation(fields: [branchId], references: [id])
  branchId        String?
  title           String
  scope           String          @default("all") // all | category
  scopeCategory   String?
  status          String          @default("in_progress") // in_progress | completed | cancelled
  startedById     String
  startedByName   String
  completedById   String?
  completedByName String?
  note            String?
  completeNote    String?
  applyToStock    Boolean         @default(false)
  totalItems      Int             @default(0) // count lines in session
  countedItems    Int             @default(0) // lines with a count entered
  systemQty       Int             @default(0) // snapshot units at session start
  countedQty      Int             @default(0) // total counted units (live)
  varianceQty     Int             @default(0) // counted - system (live/final)
  varianceValue   Float           @default(0) // sum(variance * unitCost)
  positiveLines   Int             @default(0) // surplus lines
  negativeLines   Int             @default(0) // shortage lines
  matchedLines    Int             @default(0)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  items           StockTakeItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model StockTakeItem {
  id            String    @id @default(cuid())
  stockTakeId   String
  stockTake     StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  medicineId    String
  medicineName  String
  sku           String
  unit          String    @default("Box")
  category      String?
  location      String?
  systemQty     Int // snapshot at session start
  countedQty    Int? // null = not counted yet
  varianceQty   Int? // counted - system
  unitCost      Float     @default(0) // snapshot cost for valuation
  varianceValue Float?
  countedById   String?
  countedByName String?
  countedAt     DateTime?
  note          String?
  createdAt     DateTime  @default(now())
}

model DiscountRequest {
  id             String    @id @default(cuid())
  requestCode    String    @unique // DR-2026-0001
  status         String    @default("pending") // pending | approved | rejected | used | cancelled
  cashierId      String
  cashierName    String
  subtotal       Float     @default(0)
  discountValue  Float     @default(0)
  discountPct    Float     @default(0) // discount as % of subtotal, snapshot
  itemCount      Int       @default(0)
  itemsJson      String? // JSON snapshot of cart lines at request time
  customerId     String?
  reason         String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  saleId         String? // set once the approved draft is completed as a sale
  branchRef      Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([cashierId])
}
